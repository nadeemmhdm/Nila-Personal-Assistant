# Configure these in PHP-FPM / your hosting environment. Never inside public/.
GOOGLE_CLIENT_ID=YOUR_WEB_APPLICATION_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
NILA_BROKER_URL=https://connect.example.com/index.php
# Generate two DIFFERENT random values, instructions in docs/GOOGLE_CONNECT.md.
NILA_PAIRING_KEY=REPLACE_WITH_A_RANDOM_PRIVATE_DEPLOYMENT_KEY
NILA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
NILA_DB_PATH=/var/lib/nila-oauth/sessions.sqlite
